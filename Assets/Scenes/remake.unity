  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7a90c8b826ad38f4d84008a6f33b3bec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IbArtMuseum.Remake.ResonanceInteractable
  interactType: 0
  isInteractable: 1
  promptText: "\U0001F534 [E] 1\uCE35 \uC804\uC2DC\uC791 \uBD89\uC740 \uBC84\uD2BC
    \uB204\uB974\uAE30 (\uC228\uACA8\uC9C4 \uB2E8\uC5B4 \uC870\uC0AC)"
  titleText: "1\uCE35 \uD2B9\uBCC4 \uC804\uC2DC\uC791 : \u300E\uC2EC\uC5F0 \uC18D\uC758
    \uC18C\uB140\uC640 \uC783\uC5B4\uBC84\uB9B0 \uC774\uB984\u300F"
  bodyText: "\uBD89\uC740 \uBC84\uD2BC\uC744 \uB204\uB974\uC790 \uC561\uC790 \uB4A4\uD3B8\uC758
    \uC624\uB974\uACE8 \uC7A5\uCE58\uAC00 \uB3CC\uC544\uAC00\uBA70 \uBC14\uC774\uC2A4\uB9CC
    \uBC15\uC0AC\uC758 \uC74C\uC131 \uAE30\uB85D\uC774 \uD758\uB7EC\uB098\uC628\uB2E4.\n\n\"\uB0B4
    \uC0AC\uB791\uD558\uB294 \uC9C4\uC9DC \uB538\uC758 \uC774\uB984\uC740... \u3010
    LUCIA (\uB8E8\uC2DC\uC544) \u3011... \uADF8 \uC544\uC774\uC758 \uBBF8\uC18C\uB97C
    \uB418\uCC3E\uAE30 \uC704\uD574\uC11C\uB77C\uBA74 \uB098\uB294 \uC2E0\uC758 \uC601\uC5ED\uC774\uB77C\uB3C4
    \uCE68\uBC94\uD560 \uAC83\uC774\uB2E4.\""
  clueWord: LUCIA
  floorNumber: 1
  linkedJanitor: {fileID: 0}
  hidingInsidePoint: {fileID: 0}
