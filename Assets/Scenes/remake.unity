  promptText: "[E] \uC18C\uB140(\uB808\uD50C\uB9AC\uCE74)\uC640 \uB300\uD654\uD558\uAE30"
  titleText: "\uBBF8\uC220\uAD00\uC758 \uC18C\uB140 (\uB808\uD50C\uB9AC\uCE74)"
  bodyText: "\"\uC548\uB155\uD558\uC138\uC694, \uAE30\uC790\uB2D8... \uC774 \uD3D0\uC1C4\uB41C
    \uBBF8\uC220\uAD00\uC5D0 \uCC3E\uC544\uC624\uC2E0 \uBD84\uC740 \uC815\uB9D0 \uC624\uB79C\uB9CC\uC774\uC5D0\uC694.\n\uC800\uB294
    \uC774 \uBBF8\uC220\uAD00\uC758 \uC124\uB9BD\uC790\uC774\uC2E0 \uBC14\uC774\uC2A4\uB9CC
