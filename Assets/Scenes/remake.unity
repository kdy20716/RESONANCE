  m_Script: {fileID: 11500000, guid: 7a90c8b826ad38f4d84008a6f33b3bec, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IbArtMuseum.Remake.ResonanceInteractable
  interactType: 0
  isInteractable: 1
  promptText: "\U0001F534 [E] 3\uCE35 \uC804\uC2DC\uC791 \uBD89\uC740 \uBC84\uD2BC
    \uB204\uB974\uAE30 (\uC228\uACA8\uC9C4 \uB2E8\uC5B4 \uC870\uC0AC)"
  titleText: "3\uCE35 \uD2B9\uBCC4 \uC804\uC2DC\uC791 : \u300E\uB9CC\uB4E4\uC5B4\uC9C4
    \uC778\uD615, \uB808\uD50C\uB9AC\uCE74\u300F"
  bodyText: "\uBD89\uC740 \uBC84\uD2BC\uC744 \uB204\uB974\uC790 \uC561\uC790 \uD504\uB808\uC784\uC5D0\uC11C
    \uCC28\uAC00\uC6B4 \uAE30\uACC4\uC74C\uC774 \uC6B8\uB824 \uD37C\uC9C4\uB2E4.\n\n\"\uB8E8\uC2DC\uC544\uC758
    \uAE30\uC5B5\uC744 \uC8FC\uC785\uBC1B\uC544 \uD0C4\uC0DD\uD55C \uC644\uC804\uBB34\uACB0\uD55C
    \uC778\uACF5\uC18C\uB140... \uD504\uB85C\uC81D\uD2B8 \uCF54\uB4DC\uBA85 \u3010
    REPLICA (\uB808\uD50C\uB9AC\uCE74) \u3011. \uD558\uC9C0\uB9CC \uADF8 \uC778\uD615\uC740
    \uC790\uC2E0\uC774 \uC9C4\uC9DC \uC778\uAC04\uC774\uB77C \uBBFF\uACE0 \uC788\uB2E4.\""
  clueWord: REPLICA
  floorNumber: 3
  linkedJanitor: {fileID: 0}
  hidingInsidePoint: {fileID: 0}
