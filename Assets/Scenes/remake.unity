  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IbArtMuseum.Remake.ResonanceInteractable
  interactType: 0
  isInteractable: 1
  promptText: "\U0001F534 [E] 2\uCE35 \uC804\uC2DC\uC791 \uBD89\uC740 \uBC84\uD2BC
    \uB204\uB974\uAE30 (\uC228\uACA8\uC9C4 \uB2E8\uC5B4 \uC870\uC0AC)"
  titleText: "2\uCE35 \uD2B9\uBCC4 \uC804\uC2DC\uC791 : \u300E\uC774\uC2DD\uB41C
    \uAE30\uC5B5\uC758 \uCD08\uC0C1\u300F"
  bodyText: "\uBD89\uC740 \uBC84\uD2BC\uC744 \uB204\uB974\uC790 \uADF8\uB9BC \uC18D
    \uC18C\uB140\uC758 \uB208\uAC00\uC5D0 \uBD89\uC740 \uB208\uBB3C\uC774 \uB9FA\uD788\uBA70
    \uC228\uACA8\uC9C4 \uBB38\uC7A5\uC774 \uB5A0\uC624\uB978\uB2E4.\n\n\"\uC778\uAC04\uC744
    \uC778\uAC04\uB2F5\uAC8C \uB9CC\uB4DC\uB294 \uAC83\uC740 \uC721\uCCB4\uAC00 \uC544\uB2CC
    \u3010 MEMORY (\uAE30\uC5B5) \u3011\uC774\uB2E4. \uB098\uB294 \uAD00\uB78C\uAC1D\uB4E4\uC758
    \uAE30\uC5B5 \uD30C\uB3D9\uC744 \uCD94\uCD9C\uD574 \uCE94\uBC84\uC2A4\uC5D0 \uAC00\uB450\uC5C8\uB2E4.\""
  clueWord: MEMORY
  floorNumber: 2
  linkedJanitor: {fileID: 0}
  hidingInsidePoint: {fileID: 0}
